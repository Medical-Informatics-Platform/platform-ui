{
  "name": "fl-platform",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/check-node-version.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "ng build",
    "prewatch": "node scripts/check-node-version.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/check-node-version.mjs",
    "pretypecheck": "node scripts/check-node-version.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "verify": "npm run typecheck && npm run check:dead-code && npm run build",
    "test": "ng test",
    "e2e": "playwright test"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "d3": "^7.9.0",
    "echarts": "6.1.0",
    "echarts-gl": "2.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.2",
    "ngx-echarts": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@playwright/test": "^1.64.1",
    "@types/d3": "^7.4.3",
    "@vitest/browser-playwright": "5.0.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "8.3.5"
  }
}
